# 应用安全
SECRET_KEY=your-secret-key
ALGORITHM=HS256

# 数据库（与 docker-compose.yml 中 postgres 服务保持一致）
DATABASE_URL=postgresql://agent_user:secure_password@postgres:5432/agent_db

# Redis
REDIS_URL=redis://redis:6379

# DeepSeek API
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Tavily MCP
TAVILY_API_KEY=tvly-xxx

# 魔搭可视化图表 MCP
MODELSCOPE_TOKEN=ms-xxx
# 魔搭 api-inference 托管的各 MCP 服务地址（真实 URL 只存 .env，不写死在代码里）
MODELSCOPE_CHART_URL=https://mcp.api-inference.modelscope.net/<服务id>/mcp
MODELSCOPE_AMAP_URL=https://mcp.api-inference.modelscope.net/<服务id>/sse
MODELSCOPE_FETCH_URL=https://mcp.api-inference.modelscope.net/<服务id>/mcp
MODELSCOPE_T12306_URL=https://mcp.api-inference.modelscope.net/<服务id>/mcp
MODELSCOPE_DEEPWIKI_URL=https://mcp.api-inference.modelscope.net/<服务id>/mcp
MODELSCOPE_FLIGHT_COMPARE_URL=https://mcp.api-inference.modelscope.net/<服务id>/mcp
MODELSCOPE_FOOD_URL=https://mcp.api-inference.modelscope.net/<服务id>/sse
MODELSCOPE_LEETCODE_URL=https://mcp.api-inference.modelscope.net/<服务id>/mcp
MODELSCOPE_ARXIV_URL=https://mcp.api-inference.modelscope.net/<服务id>/mcp

# 智谱视频生成
ZHIPU_API_KEY=xxx
ZHIPU_BASE_URL=https://open.bigmodel.cn

# 媒体转存（均有默认值，可按需覆盖）
MEDIA_UPLOAD_DIR=uploads
MEDIA_URL_PREFIX=/media
MEDIA_MAX_SIZE=104857600
MEDIA_DOWNLOAD_TIMEOUT=60

# 日志
LOG_LEVEL=INFO

# 可观测性（阶段 6）：OpenTelemetry 追踪
# 服务名，在 Trace 后端（Jaeger）中展示
SERVICE_NAME=agent-orchestrator
# OTLP HTTP 端点；留空则降级为控制台输出 span（无需后端即可查看）
# 接本地 Jaeger：先 docker run -d --name jaeger -p 16686:16686 -p 4318:4318 jaegertracing/all-in-one:latest
# 再填 OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=
