# 应用安全
SECRET_KEY=your-secret-key
ALGORITHM=HS256

# 数据库（与 docker-compose.yml 中 postgres 服务保持一致）
DATABASE_URL=postgresql://agent_user:secure_password@postgres:5432/agent_db

# Redis
REDIS_URL=redis://redis:6379

# DeepSeek API
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型路由（前端可选模型；JSON 数组，每项 id/name/base_url/api_key/fallback）
# base_url/api_key 留空时回退 DeepSeek；api_key 支持 @VAR 引用 settings 字段（如 @ZHIPU_API_KEY），避免明文重复
# fallback 为可选备用模型 id，留空时降级回退 DEFAULT_MODEL
# 留空时默认 deepseek-v4-pro / deepseek-v4-flash 两档
MODEL_ROUTES='[
  {"id":"deepseek-v4-pro","name":"DeepSeek V4 Pro","base_url":"","api_key":""},
  {"id":"deepseek-v4-flash","name":"DeepSeek V4 Flash","base_url":"","api_key":""},
  {"id":"dots-studio/dots-3-note-preview:free","name":"Dots 3 Note Preview","base_url":"https://openrouter.ai/api/v1","api_key":"@OPENROUTER_API_KEY"},
  {"id":"nvidia/nemotron-3.5-lightning:free","name":"Nemotron 3.5 Lightning","base_url":"https://openrouter.ai/api/v1","api_key":"@OPENROUTER_API_KEY","hidden":true},
  {"id":"poolside/laguna-xs-2.1:free","name":"Poolside Laguna XS 2.1","base_url":"https://openrouter.ai/api/v1","api_key":"@OPENROUTER_API_KEY","hidden":true,"fallback":"deepseek-v4-flash"},
  {"id":"cohere/north-mini-code:free","name":"Cohere North Mini Code","base_url":"https://openrouter.ai/api/v1","api_key":"@OPENROUTER_API_KEY","hidden":true,"fallback":"deepseek-v4-flash"},
  {"id":"nvidia/nemotron-3-ultra-550b-a55b:free","name":"Nemotron 3 Ultra","base_url":"https://openrouter.ai/api/v1","api_key":"@OPENROUTER_API_KEY","hidden":true,"fallback":"deepseek-v4-flash"},
  {"id":"nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free","name":"Nemotron 3 Nano Omni","base_url":"https://openrouter.ai/api/v1","api_key":"@OPENROUTER_API_KEY","hidden":true,"fallback":"deepseek-v4-flash"},
  {"id":"glm-4.5-flash","name":"智谱 GLM-4.5-Flash","base_url":"https://open.bigmodel.cn/api/paas/v4","api_key":"@ZHIPU_API_KEY","fallback":"deepseek-v4-pro"}
]'
DEFAULT_MODEL=deepseek-v4-pro

# Tavily MCP
TAVILY_API_KEY=tvly-xxx

# 魔搭可视化图表 MCP
MODELSCOPE_TOKEN=ms-xxx
# 魔搭 api-inference 托管的各 MCP 服务地址（真实 URL 只存 .env，不写死在代码里）
MODELSCOPE_CHART_URL=https://mcp.api-inference.modelscope.net/<服务id>/mcp
MODELSCOPE_AMAP_URL=https://mcp.api-inference.modelscope.net/<服务id>/sse
MODELSCOPE_FETCH_URL=https://mcp.api-inference.modelscope.net/<服务id>/mcp
MODELSCOPE_T12306_URL=https://mcp.api-inference.modelscope.net/<服务id>/mcp
MODELSCOPE_DEEPWIKI_URL=https://mcp.api-inference.modelscope.net/<服务id>/mcp
MODELSCOPE_FLIGHT_COMPARE_URL=https://mcp.api-inference.modelscope.net/<服务id>/mcp
MODELSCOPE_FOOD_URL=https://mcp.api-inference.modelscope.net/<服务id>/sse
MODELSCOPE_LEETCODE_URL=https://mcp.api-inference.modelscope.net/<服务id>/mcp
MODELSCOPE_ARXIV_URL=https://mcp.api-inference.modelscope.net/<服务id>/mcp
MODELSCOPE_DOCUMENT_GENERATOR_URL=https://mcp.api-inference.modelscope.net/<服务id>/mcp
MODELSCOPE_BAZI_URL=https://mcp.api-inference.modelscope.net/<服务id>/mcp
MODELSCOPE_QWEN_VIDEO_URL=https://mcp.api-inference.modelscope.net/<服务id>/mcp

# 智谱视频生成
ZHIPU_API_KEY=xxx
ZHIPU_BASE_URL=https://open.bigmodel.cn

# OpenRouter（聚合多家模型供应商的统一网关）
OPENROUTER_API_KEY=xxx

# 媒体转存（均有默认值，可按需覆盖）
MEDIA_UPLOAD_DIR=uploads
MEDIA_URL_PREFIX=/media
MEDIA_MAX_SIZE=104857600
MEDIA_DOWNLOAD_TIMEOUT=60

# 文件上传与解析（阶段 9，均有默认值，可按需覆盖）
FILE_UPLOAD_STORAGE=local
FILE_UPLOAD_DIR=file_uploads
FILE_MAX_SIZE=20971520
FILE_QUOTA_BYTES=536870912
FILE_GLOBAL_QUOTA_BYTES=8589934592
FILE_RETENTION_DAYS=3
FILE_PARSE_MODE=transient
FILE_TEXT_MAX_CHARS=12000
FILE_DOWNLOAD_TIMEOUT=300
FILE_DOWNLOAD_CHUNKS=4

# 附件 LLM 语义压缩（阶段 9 增强，均有默认值；FILE_COMPRESS_MODEL_WINDOWS 仅代码默认值，不入 env）
FILE_COMPRESS_ENABLED=true
FILE_COMPRESS_MODEL=deepseek-v4-flash
FILE_COMPRESS_BASE_URL=
FILE_COMPRESS_API_KEY=
FILE_COMPRESS_CHARS_PER_TOKEN=2
FILE_COMPRESS_WINDOW_RATIO=0.5
FILE_COMPRESS_MAX_CHUNKS=8
FILE_COMPRESS_TIMEOUT=60

# 百度云 OCR（PP-OCRv6，扫描件 PDF 与图片识别；不启用则扫描件/图片保持空文本）
BAIDU_OCR_ENABLED=false
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
BAIDU_OCR_MAX_PAGES=20

# 百度云 ASR（短语音识别极速版；AK/SK 复用上方 BAIDU_API_KEY/BAIDU_SECRET_KEY）
BAIDU_ASR_DEV_PID=80001
BAIDU_ASR_MAX_SECONDS=30

# 七牛云 Kodo（FILE_UPLOAD_STORAGE=qiniu 时必填；真实密钥只填到 .env，不入库）
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=

# 日志
LOG_LEVEL=INFO

# 可观测性（阶段 6）：OpenTelemetry 追踪
# 服务名，在 Trace 后端（Jaeger）中展示
SERVICE_NAME=agent-orchestrator
# OTLP HTTP 端点；留空则降级为控制台输出 span（无需后端即可查看）
# 接本地 Jaeger：先 docker run -d --name jaeger -p 16686:16686 -p 4318:4318 jaegertracing/all-in-one:latest
# 再填 OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=
